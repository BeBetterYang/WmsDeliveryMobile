<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="deploy\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="deploy\**\*" />
    <Content Remove="android-shell\**\*" />
    <Content Remove="node_modules\**\*" />
    <Content Remove="src\**\*" />
    <Content Remove="UserData\**\*" />
    <Content Remove="index.html" />
    <Content Remove="package.json" />
    <Content Remove="package-lock.json" />
    <Content Remove="server.log" />
    <Content Remove="vite.config.js" />
    <None Remove="deploy\**\*" />
    <None Remove="android-shell\**\*" />
    <None Remove="node_modules\**\*" />
    <None Remove="src\**\*" />
    <None Remove="UserData\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="dist\**\*">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
